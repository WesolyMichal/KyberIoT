508:               static void atcacert_copy_device_loc_data(const atcacert_device_loc_t* device_loc_src,
509:                                                         const uint8_t*               data_src,
510:                                                         const atcacert_device_loc_t* device_loc_dest,
511:                                                         uint8_t*                     data_dest)
512:               {
513:                   size_t offset = ATCACERT_MAX(device_loc_src->offset, device_loc_dest->offset);
514:                   size_t end    = ATCACERT_MIN(device_loc_src->offset + device_loc_src->count, device_loc_dest->offset + device_loc_dest->count);
515:               
516:                   memcpy(&data_dest[offset - device_loc_dest->offset], &data_src[offset - device_loc_src->offset], end - offset);
517:               }
