306:               static uint8_t UART1_RxDataAvailable(void)
307:               {
308:                   uint16_t size;
309:                   uint8_t *snapshot_rxTail = (uint8_t*)rxTail;
310:                   
311:                   if (snapshot_rxTail < rxHead) 
312:                   {
313:                       size = ( UART1_CONFIG_RX_BYTEQ_LENGTH - (rxHead-snapshot_rxTail));
314:                   }
315:                   else
316:                   {
317:                       size = ( (snapshot_rxTail - rxHead));
318:                   }
319:                   
320:                   if(size > 0xFF)
321:                   {
322:                       return 0xFF;
323:                   }
324:                   
325:                   return size;
326:               }
