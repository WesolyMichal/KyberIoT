193:                   uint32_t digit_value = 1;
194:                   int digit;
195:               
196:                   str += width - 1;
197:                   *num = 0;
198:                   for (digit = 0; digit < width; digit++)
199:                   {
200:                       if (*str < '0' || *str > '9')
201:                       {
202:                           return error_ret;  // Character is not a digit
