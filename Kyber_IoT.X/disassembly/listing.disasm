154:               inline static uint8_t hex_digit_to_num(char c)
155:               {
156:                   if (c >= '0' && c <= '9')
157:                   {
158:                       return (uint8_t)(c - '0');
159:                   }
160:                   if (c >= 'a' && c <= 'f')
161:                   {
162:                       return (uint8_t)(c - 'a') + 10;
163:                   }
164:                   if (c >= 'A' && c <= 'F')
165:                   {
166:                       return (uint8_t)(c - 'A') + 10;
167:                   }
168:                   return 16;
169:               }
