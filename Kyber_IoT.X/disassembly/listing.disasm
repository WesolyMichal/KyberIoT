373:                       {
374:                           return ATCA_BAD_PARAM;
00005A  000534     NOP
375:                       }
376:                       atcac_sw_sha2_256_update(&ctx, param->signature, SECUREBOOT_SIGNATURE_SIZE);
377:                   }
378:               
379:                   // Add SecureBoot input parameters
380:                   input_params[0] = ATCA_SECUREBOOT;               // SecureBoot Opcode
381:                   input_params[1] = param->mode;                   // SecureBoot Mode (Param1)
382:                   input_params[2] = (uint8_t)(param->param2 >> 0); // SecureBoot Param2 (LSB)
383:                   input_params[3] = (uint8_t)(param->param2 >> 8); // SecureBoot Param2 (MSB)
384:                   atcac_sw_sha2_256_update(&ctx, input_params, sizeof(input_params));
385:               
386:                   atcac_sw_sha2_256_finish(&ctx, param->mac);
387:               
388:                   return ATCA_SUCCESS;
389:               }
