112:                * \return ATCA_SUCCESS
113:                */
114:               ATCA_STATUS atGenDig(ATCACommand ca_cmd, ATCAPacket *packet, bool is_no_mac_key)
115:               {
116:                   // Set the opcode & parameters
117:                   packet->opcode = ATCA_GENDIG;
118:               
119:                   if (packet->param1 == GENDIG_ZONE_SHARED_NONCE) // shared nonce mode
120:                   {
121:                       packet->txsize = GENDIG_COUNT + 32;
