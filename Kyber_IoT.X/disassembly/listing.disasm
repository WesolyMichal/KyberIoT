488:               int atcacert_is_device_loc_overlap(const atcacert_device_loc_t* device_loc1,
489:                                                  const atcacert_device_loc_t* device_loc2)
490:               {
491:                   if (device_loc1->zone != device_loc2->zone)
492:                   {
493:                       return FALSE;   // Zones don't match, can't overlap
494:                   }
495:                   if (device_loc1->zone == DEVZONE_DATA && device_loc1->slot != device_loc2->slot)
496:                   {
497:                       return FALSE;   // Data zone, slots don't match, can't overlap
498:                   }
499:                   if (device_loc1->zone == DEVZONE_DATA && device_loc1->is_genkey != device_loc2->is_genkey)
500:                   {
501:                       return FALSE;   // Data zone, same slot, but read method doesn't match, can't overlap
502:               
503:                   }
504:                   return !(   device_loc1->offset + device_loc1->count <= device_loc2->offset
505:                               || device_loc1->offset >= device_loc2->offset + device_loc2->count);
506:               }
