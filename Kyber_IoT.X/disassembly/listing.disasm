163:               /**
164:                * \brief Convert an unsigned integer to a zero padded string with no terminating null.
165:                */
166:               static uint8_t* uint_to_str(uint32_t num, int width, uint8_t* str)
167:               {
168:                   uint8_t* ret = str + width;
169:                   int i;
170:               
171:                   // Pre-fill the string width with zeros
172:                   for (i = 0; i < width; i++)
