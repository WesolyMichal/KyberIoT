1013:              uint32 nmi_inet_addr(char *pcIpAddr)
1014:              {
1015:              	uint8	tmp;
1016:              	uint32	u32IP = 0;
1017:              	uint8	au8IP[4];
1018:              	uint8 	c;
1019:              	uint8	i, j;
1020:              
1021:              	tmp = 0;
1022:              
1023:              	for(i = 0; i < 4; ++i)
1024:              	{
1025:              		j = 0;
1026:              		do
1027:              		{
1028:              			c = *pcIpAddr;
000018  000534     NOP
1029:              			++j;
1030:              			if(j > 4)
000024  000534     NOP
1031:              			{
1032:              				return 0;
1033:              			}
1034:              			if(c == '.' || c == 0)
1035:              			{
1036:              				au8IP[i] = tmp;
00003C  000534     NOP
1037:              				tmp = 0;
000046  000534     NOP
1038:              			}
1039:              			else if(c >= '0' && c <= '9')
1040:              			{
1041:              				tmp = (tmp * 10) + (c - '0');
00005C  000534     NOP
1042:              			}
1043:              			else
1044:              			{
1045:              				return 0;
00006E  000534     NOP
1046:              			}
1047:              			++pcIpAddr;
000072  000534     NOP
1048:              		} while(c != '.' && c != 0);
000078  0004A6     NOP
1049:              	}
1050:              	m2m_memcpy((uint8*)&u32IP, au8IP, 4);
1051:              	return u32IP;
00009C  000534     NOP
1052:              }
