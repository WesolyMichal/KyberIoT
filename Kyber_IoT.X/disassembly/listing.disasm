672:               int atcacert_set_signature(const atcacert_def_t* cert_def,
673:                                          uint8_t*              cert,
674:                                          size_t*               cert_size,
675:                                          size_t                max_cert_size,
676:                                          const uint8_t         signature[64])
677:               {
678:                   int ret = 0;
679:                   uint16_t sig_offset;
680:                   size_t cur_der_sig_size;
681:                   size_t new_der_sig_size;
682:                   size_t old_cert_der_length_size;
683:                   uint32_t new_cert_length;
684:               
685:                   if (cert_def == NULL || cert == NULL || cert_size == NULL || signature == NULL)
686:                   {
687:                       return ATCACERT_E_BAD_PARAMS;
688:                   }
689:               
690:                   sig_offset = cert_def->std_cert_elements[STDCERT_SIGNATURE].offset;
