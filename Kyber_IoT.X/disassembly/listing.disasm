45:                /********************Timeout Driver for MQTT definitions***********************/
46:                //#define timerstruct_t                   timer_struct_t
47:                #define htons(a)                        _htons(a)
48:                #define ntohs(a)                        _ntohs(a)
49:                
50:                // Timeout is calculated on the basis of clock frequency.
51:                // This macros need to be changed in accordance with the clock frequency.
52:                #define SECONDS (uint32_t)1000
53:                
54:                #define WAITFORCONNACK_TIMEOUT              timeout_mSecToTicks((30 * SECONDS))
55:                #define WAITFORPINGRESP_TIMEOUT             timeout_mSecToTicks((30 * SECONDS))
56:                #define WAITFORSUBACK_TIMEOUT				timeout_mSecToTicks((30 * SECONDS))
57:                #define WAITFORUNSUBACK_TIMEOUT				timeout_mSecToTicks((30 * SECONDS))
58:                
59:                
60:                /*******************Timeout Driver for MQTT definitions*(END)******************/
61:                
62:                /***********************MQTT Client definitions********************************/
63:                
64:                #define MQTT_TX_PACKET_DECISION_CONSTANT    0x01
65:                #define KEEP_ALIVE_CALCULATION_CONSTANT     0x01
66:                #define CONNECT_CLEAN_SESSION_MASK          0x02
67:                
68:                
69:                // MQTT packet transmission flags. The creation and transmission processes of
70:                // MQTT control packets uses a set of flags to indicate that a new packet is
71:                // created and available for transmission. These flags are defined here.
72:                
73:                typedef union {
74:                   uint8_t All;
75:                
76:                   struct {
77:                      unsigned newTxConnectPacket : 1; // Indicates new CONNECT packet available for transmission
78:                      unsigned newTxDisconnectPacket : 1; // Indicates new DISCONNECT packet available for transmission
79:                      unsigned newTxPublishPacket : 1; // Indicates new PUBLISH packet available for transmission
80:                      unsigned newTxSubscribePacket : 1; // Indicates new SUBSCRIBE packet available for transmission
81:                      unsigned newTxUnsubscribePacket : 1; // Indicates new UNSUBSCRIBE packet available for transmission
82:                      unsigned newTxPingreqPacket : 1; // Indicates new PINGREQ packet available for transmission
83:                      unsigned : 2; // Reserved
84:                   };
85:                } newTxDataFlags;
86:                
87:                // MQTT packet reception flags. The reception processes of MQTT control packets
88:                // uses a set of flags to identify the received packet type in order to
89:                // correctly process it. These flags are defined here.
90:                
91:                typedef union {
92:                   uint8_t All;
93:                
94:                   struct {
95:                      unsigned newRxConnackPacket : 1; // Indicates new CONNACK packet has been received
96:                      unsigned newRxPublishPacket : 1; // Indicates new PUBLISH packet has been received
97:                      unsigned newRxSubackPacket : 1; // Indicates new SUBACK packet has been received
98:                      unsigned newRxUnsubackPacket : 1; // Indicates new UNSUBACK packet has been received
99:                      unsigned newRxPingrespPacket : 1; // Indicates new PINGRESP packet has been received
100:                     unsigned newRxPubackPacket : 1; // Indicates new PUBACK packet has been received
101:                     unsigned : 2; // Reserved
102:                  };
103:               } newRxDataFlags;
104:               
105:               // MQTT packet transmission states. The transmission of MQTT control packets is
106:               // performed inside the CONNECTED state. The Tx state machine states are defined
107:               // here. These need to correspond to the respective flags in the union
108:               // newTxDataFlags.
109:               
110:               typedef enum {
111:                  SENDDISCONNECT = 2,
112:                  SENDPUBLISH = 4,
113:                  SENDSUBSCRIBE = 8,
114:                  SENDUNSUBSCRIBE = 16,
115:                  SENDPINGREQ = 32,
116:               } mqttConnectCurrentTxSubstate;
117:               
118:               // Function pointer for handling QoS levels.
119:               typedef void (*qosLevelHandler)(uint8_t);
120:               
121:               // The QoS levels in PUBLISH message are 0, 1 and 2 with quality of service
122:               // increasing from QoS level 0 to 2. QoS level processing needs information
123:               // about the QoS level and the appropriate callback function. The call back
124:               // table type for determining whether the correct callback function for the QoS
125:               // level under consideration is defined here.
126:               
127:               typedef struct {
128:                  uint8_t qosLevel;
129:                  qosLevelHandler qosLevelHandlerFunction;
130:               } qosLevelHandler_t;
131:               
132:               /***********************MQTT Client definitions*(END)**************************/
133:               
134:               
135:               /***********************MQTT Client variables**********************************/
