173:                   {
174:                       *(str++) = '0';
175:                   }
176:                   // Convert the number from right to left
177:                   for (; num; num /= 10)
178:                   {
179:                       *(--str) = '0' + (num % 10);
180:                   }
181:               
182:                   return ret;
183:               }
