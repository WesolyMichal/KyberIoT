361:               /** \brief Check whether timeout has occurred after sending CONNECT
362:               packet.
363:                *
364:                * This function checks whether a timeout (30s) has occurred after sending
365:               CONNECT packet, since a CONNACK packet is expected from the broker
366:               within 30s.
367:                *
368:                * @param none
369:                *
370:                * @return
371:                *  - The number of ticks till the connackTimer expires.
372:                */
373:               static uint32_t checkConnackTimeoutState();
374:               timerStruct_t connackTimer = {checkConnackTimeoutState, NULL};
375:               
376:               /** \brief Check whether timeout has occurred after receiving CONNACK
377:               or PINGRESP packet.
378:                *
379:                * This function checks whether a timeout of (keepAliveTime)s has occurred after
380:               receiving CONNACK or PINGRESP packet, since a client is expected to send some
381:               packet to the broker within (keepAliveTime)s time period.
382:                *
383:                * @param none
384:                *
385:                * @return
386:                *  - The number of ticks till the connackTimer or pingrespTimer expires.
387:                */
388:               static uint32_t checkPingreqTimeoutState();
389:               timerStruct_t pingreqTimer = {checkPingreqTimeoutState, NULL};
390:               
391:               /** \brief Check whether timeout has occurred after sending PINGREQ
392:               packet.
393:                *
394:                * This function checks whether a timeout (30s) has occurred after sending
395:               PINGREQ packet. In the current MQTT client implementation, the client
396:               waits for 30s after transmission of PINGREQ packet to receive a PINGRESP
397:               packet.
398:                *
399:                * @param none
400:                *
401:                * @return
402:                *  - The number of ticks till the pingreq expires.
403:                */
404:               static uint32_t checkPingrespTimeoutState();
405:               timerStruct_t pingrespTimer = {checkPingrespTimeoutState, NULL};
406:               	
407:               
408:               /** \brief Check whether timeout has occurred after sending SUBSCRIBE
409:               packet.
410:                *
411:                * This function checks whether a timeout (30s) has occurred after sending
412:               SUBSCRIBE packet. In the current MQTT client implementation, the client
413:               waits for 30s after transmission of SUBSCRIBE packet to receive a SUBACK
414:               packet.
415:               * If the client does not receive a SUBACK packet from the server in a 
416:               reasonable period of time (currently set to 30s), it is treated as a 
417:               protocol violation. The client therefore will close the Network 
418:               Connection by checking subackTimeoutOccured flag (MQTT RFC, section 4.8).
419:                *
420:                * @param none
421:                *
422:                * @return
423:                *  - The number of ticks till the suback expires.
424:                */
425:               static uint32_t checkSubackTimeoutState();
426:               timerStruct_t subackTimer = {checkSubackTimeoutState, NULL};
427:               	
428:               
429:               /** \brief Check whether timeout has occurred after sending UNSUBSCRIBE
430:               packet.
431:                *
432:                * This function checks whether a timeout (30s) has occurred after sending
433:               UNSUBSCRIBE packet. In the current MQTT client implementation, the client
434:               waits for 30s after transmission of UNSUBSCRIBE packet to receive a UNSUBACK
435:               packet.
436:               * If the client does not receive a UNSUBACK packet from the server in a 
437:               reasonable period of time (currently set to 30s), it is treated as a 
438:               protocol violation. The client therefore will close the Network 
439:               Connection by checking unsubackTimeoutOccured flag (MQTT RFC, section 4.8).
440:                *
441:                * @param none
442:                *
443:                * @return
444:                *  - The number of ticks till the unsuback expires.
445:                */
446:               static uint32_t checkUnsubackTimeoutState();
447:               timerStruct_t unsubackTimer = {checkUnsubackTimeoutState, NULL};
448:               	
