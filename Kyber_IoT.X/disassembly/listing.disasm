41:                /**
42:                 *  \ingroup doc_driver_i2c_code
43:                 *  \brief Function to write 1 byte of data to a register location
44:                 *  
45:                 *  \param [in] address [type]i2c_address_t The slave address
46:                 *         [in] reg     [type]uint8_t The register address to be written to
47:                 *         [in] data    [type]uint8_t The data to be written
48:                 *  
49:                 *  \return None
50:                 */
51:                void i2c_write1ByteRegister(i2c_address_t address, uint8_t reg, uint8_t data)
52:                {
53:                    while(!i2c_open(address)); // sit here until we get the bus..
54:                    i2c_setDataCompleteCallback(wr1RegCompleteHandler,&data);
55:                    i2c_setBuffer(&reg,1);
56:                    i2c_setAddressNACKCallback(i2c_restartWrite,NULL); //NACK polling?
57:                    i2c_masterWrite();
58:                    while(I2C_BUSY == i2c_close()); // sit here until finished.
59:                }
60:                
