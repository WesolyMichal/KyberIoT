252:               static int get_effective_offset(const atcacert_def_t* cert_def, const uint8_t* cert, size_t ref_offset)
253:               {
254:                   size_t sn_offset = 0;
255:               
256:                   if (cert_def->type != CERTTYPE_X509 || cert_def->sn_source != SNSRC_STORED_DYNAMIC)
257:                   {
258:                       return 0;
259:                   }
260:               
261:                   sn_offset = cert_def->std_cert_elements[STDCERT_CERT_SN].offset;
262:                   if (ref_offset <= sn_offset)
263:                   {
264:                       return 0;
265:                   }
266:               
267:                   return (int)cert[sn_offset] - (int)cert_def->cert_template[sn_offset];
268:               }
