366:                   // Signature is only skipped when running the SecureBoot command in
367:                   // FullStore mode and SecureBootMode from the configuration zone is set to
368:                   // FullDig
369:                   if (!((param->mode & SECUREBOOT_MODE_MASK) == SECUREBOOT_MODE_FULL_STORE &&
370:                         (param->secure_boot_config & SECUREBOOTCONFIG_MODE_MASK) == SECUREBOOTCONFIG_MODE_FULL_DIG))
