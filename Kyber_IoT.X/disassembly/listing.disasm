33:                /** \brief This function copies otp and sn data into a command buffer.
34:                 *
35:                 * \param[in, out] param pointer to parameter structure
36:                 * \return pointer to command buffer byte that was copied last
37:                 */
38:                uint8_t *atcah_include_data(struct atca_include_data_in_out *param)
39:                {
40:                    if (param->mode & MAC_MODE_INCLUDE_OTP_88)
41:                    {
42:                        memcpy(param->p_temp, param->otp, 11);            // use OTP[0:10], Mode:5 is overridden
43:                        param->p_temp += 11;
44:                    }
45:                    else
46:                    {
47:                        if (param->mode & MAC_MODE_INCLUDE_OTP_64)
48:                        {
49:                            memcpy(param->p_temp, param->otp, 8);         // use 8 bytes OTP[0:7] for (6)
50:                        }
51:                        else
52:                        {
53:                            memset(param->p_temp, 0, 8);                  // use 8 zeros for (6)
54:                        }
55:                        param->p_temp += 8;
56:                
57:                        memset(param->p_temp, 0, 3);                     // use 3 zeros for (7)
58:                        param->p_temp += 3;
59:                    }
60:                
61:                    // (8) 1 byte SN[8]
62:                    *param->p_temp++ = param->sn[8];
63:                
64:                    // (9) 4 bytes SN[4:7] or zeros
65:                    if (param->mode & MAC_MODE_INCLUDE_SN)
66:                    {
67:                        memcpy(param->p_temp, &param->sn[4], 4);           //use SN[4:7] for (9)
68:                    }
69:                    else
70:                    {
71:                        memset(param->p_temp, 0, 4);                       //use zeros for (9)
72:                    }
73:                    param->p_temp += 4;
74:                
75:                    // (10) 2 bytes SN[0:1]
76:                    *param->p_temp++ = param->sn[0];
77:                    *param->p_temp++ = param->sn[1];
78:                
79:                    // (11) 2 bytes SN[2:3] or zeros
80:                    if (param->mode & MAC_MODE_INCLUDE_SN)
81:                    {
82:                        memcpy(param->p_temp, &param->sn[2], 2);           //use SN[2:3] for (11)
83:                    }
84:                    else
85:                    {
86:                        memset(param->p_temp, 0, 2);                       //use zeros for (9)
87:                    }
88:                    param->p_temp += 2;
89:                
90:                    return param->p_temp;
91:                }
