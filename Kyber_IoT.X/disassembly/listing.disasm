308:               /** \brief Encrypts the digest for the SecureBoot command when using the
309:                *          encrypted digest / validating mac option.
310:                *
311:                * \param[inout] param  Data required to perform the operation.
312:                *
313:                * \return ATCA_SUCCESS on success, otherwise an error code.
314:                */
315:               ATCA_STATUS atcah_secureboot_enc(atca_secureboot_enc_in_out_t* param)
316:               {
317:                   atcac_sha2_256_ctx ctx;
318:                   size_t i;
319:               
320:                   // Check parameters
321:                   if (param->digest == NULL || param->temp_key == NULL || param->hashed_key == NULL || param->io_key == NULL || param->digest_enc == NULL)
322:                   {
323:                       return ATCA_BAD_PARAM;
324:                   }
325:               
326:                   // Calculate key for encrypting digest
327:                   atcac_sw_sha2_256_init(&ctx);
328:                   atcac_sw_sha2_256_update(&ctx, param->io_key, ATCA_KEY_SIZE);
329:                   atcac_sw_sha2_256_update(&ctx, param->temp_key->value, ATCA_KEY_SIZE);
330:                   atcac_sw_sha2_256_finish(&ctx, param->hashed_key);
331:               
332:                   // Encrypt digest (XOR with key)
333:                   for (i = 0; i < SECUREBOOT_DIGEST_SIZE; i++)
334:                   {
335:                       param->digest_enc[i] = param->digest[i] ^ param->hashed_key[i];
336:                   }
337:               
338:                   return ATCA_SUCCESS;
339:               }
