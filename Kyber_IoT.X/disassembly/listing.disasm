40:                int atcacert_date_enc(atcacert_date_format_t   format,
41:                                      const atcacert_tm_utc_t* timestamp,
42:                                      uint8_t*                 formatted_date,
43:                                      size_t*                  formatted_date_size)
44:                {
45:                    if (timestamp == NULL || formatted_date_size == NULL || format < 0 || format >= sizeof(ATCACERT_DATE_FORMAT_SIZES) / sizeof(ATCACERT_DATE_FORMAT_SIZES[0]))
46:                    {
47:                        return ATCACERT_E_BAD_PARAMS;
48:                    }
49:                
50:                    if (formatted_date != NULL && *formatted_date_size < ATCACERT_DATE_FORMAT_SIZES[format])
51:                    {
52:                        *formatted_date_size = ATCACERT_DATE_FORMAT_SIZES[format];
53:                        return ATCACERT_E_BUFFER_TOO_SMALL;
54:                    }
55:                    *formatted_date_size = ATCACERT_DATE_FORMAT_SIZES[format];
56:                    if (formatted_date == NULL)
57:                    {
58:                        return ATCACERT_E_SUCCESS;  // Caller just wanted
59:                
60:                    }
61:                    switch (format)
62:                    {
