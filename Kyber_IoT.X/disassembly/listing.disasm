62:                // I2C Status Structure
63:                typedef struct
64:                {
65:                    unsigned busy:1;
66:                    unsigned inUse:1;
67:                    unsigned bufferFree:1;
68:                    unsigned addressNACKCheck:1;
69:                    i2c_address_t address;       /// The I2C Address
70:                    uint8_t *data_ptr;           /// pointer to a data buffer
71:                    size_t data_length;          /// Bytes in the data buffer
72:                    uint16_t time_out;           /// I2C Timeout Counter between I2C Events.
73:                    uint16_t time_out_value;     /// Reload value for the timeouts
74:                    i2c_fsm_states_t state;      /// Driver State
75:                    i2c_error_t error;
76:                    i2c_callback callbackTable[6];
77:                    void *callbackPayload[6];    ///  each callback can have a payload
78:                } i2c_status_t;
