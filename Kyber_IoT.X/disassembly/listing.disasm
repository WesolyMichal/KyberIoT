70:                        free(ca_dev);
71:                        ca_dev = NULL;
72:                        return NULL;
73:                    }
74:                
75:                    status = initATCADevice(cfg, ca_dev);
76:                    if (status != ATCA_SUCCESS)
77:                    {
78:                        free(ca_dev->mIface);
79:                        free(ca_dev->mCommands);
80:                        free(ca_dev);
81:                        ca_dev = NULL;
82:                        return NULL;
83:                    }
84:                
85:                    return ca_dev;
86:                }
