123:                   else if (is_no_mac_key)
124:                   {
125:                       packet->txsize = GENDIG_COUNT + 4;  // noMac keys use 4 bytes of OtherData in calculation
126:                   }
127:                   else
128:                   {
129:                       packet->txsize = GENDIG_COUNT;
130:                   }
131:                   atCalcCrc(packet);
132:                   return ATCA_SUCCESS;
133:               }
