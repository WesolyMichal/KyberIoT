51:                
52:                    ca_dev = (ATCADevice)malloc(sizeof(*ca_dev));
53:                    if (ca_dev == NULL)
54:                    {
55:                        return NULL;
56:                    }
57:                
58:                    ca_dev->mCommands = (ATCACommand)malloc(sizeof(*(ca_dev->mCommands)));
59:                    if (ca_dev->mCommands == NULL)
60:                    {
61:                        free(ca_dev);
62:                        ca_dev = NULL;
63:                        return NULL;
64:                    }
65:                
