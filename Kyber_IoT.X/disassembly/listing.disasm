922:               static void uint8_to_hex(uint8_t num, uint8_t* hex_str)
923:               {
924:                   uint8_t nibble = (num >> 4) & 0x0F;
925:               
926:                   if (nibble < 10)
927:                   {
928:                       *(hex_str++) = '0' + nibble;
000014  000534     NOP
929:                   }
930:                   else
931:                   {
932:                       *(hex_str++) = 'A' + (nibble - 10);
933:                   }
934:                   nibble = num & 0x0F;
935:                   if (nibble < 10)
936:                   {
937:                       *(hex_str++) = '0' + nibble;
938:                   }
939:                   else
940:                   {
941:                       *(hex_str++) = 'A' + (nibble - 10);
942:                   }
943:               }
