107:               bool i2c2_driver_initSlaveHardware(void)
108:               {
109:                   if(!I2C2CONLbits.I2CEN)
110:                   {
111:               /* NOTE on AHEN:
112:                * If multiple slaves are to be emulated, then AHEN must be set.  It must be set
113:                * because the driver needs to selectively ACK/NACK the address depending on its
114:                * ability to handle the address.
115:               */
116:               
117:               /* NOTE on DHEN:
118:                * DHEN must be set so that the data is not automatically NACK'ed if it is not read
119:                * from the SSPBUF.  This driver will ALWAYS read the SSPBUF so that it can pass
120:                * the value to the appropriate slave handler.  Because the data is ALWAYS read
121:                * the data will always be ACK'd if DHEN is cleared.  If the slave does not want
122:                * the data byte from the master then it will return false and a NACK will be returned.
123:                */
124:               
125:               /* NOTE on SEN:
126:                * SEN will be set enabling clock stretching.  This is because we don't know how
127:                * long the user will take to process data bytes in their callbacks.  If they are fast,
128:                * we may not need to stretch the clock.  If they are slow, we need to stretch the clock.
129:                * If we ALWAYS stretch the clock, we will release the clock when the ISR is complete.
130:                */
131:               
132:               /* NOTE on PCIE:
133:                * PCIE will be set to enable interrupts on STOP.  This will allow us know when
134:                * the master is finished
135:                */
136:                       
137:               /* NOTE on SCIE:
138:                * SCIE will be set to enable interrupts on START.  This will allow us to detect
139:                * both a START and a RESTART event and prepare to restart communications.
140:                */
141:                       I2C2CONHbits.AHEN = 1;
00000C  0003F6     NOP
142:                       I2C2CONHbits.DHEN = 1;
00000E  000534     NOP
143:                       I2C2CONLbits.STREN = 1;
000010  000534     NOP
144:                       
145:                       I2C2CONLbits.I2CEN = 1;
146:                       return true;
147:                   }
148:                   return false;
149:               }
