391:               	} 
392:               	
393:               	if (wincBindReturn != WINC_SOCK_ERR_NO_ERROR)
394:               	{
395:               		switch(wincBindReturn)
396:               		{
397:               			case WINC_SOCK_ERR_INVALID_ARG:
398:               				if(socket < 0)
399:               				{
400:               					bsd_setErrNo(ENOTSOCK);
401:               				}
402:               				else if(addr != NULL)
403:               				{
404:               					bsd_setErrNo(EFAULT);
405:               				}
406:               				else if(addrlen == 0)
407:               				{
408:               					bsd_setErrNo(EINVAL);
409:               				}
410:               				break;
000064  000534     NOP
411:               			case WINC_SOCK_ERR_INVALID:
412:               				bsd_setErrNo(EIO);
413:               				break;
414:               			default:
415:               				break;
416:               		}
417:               		return BSD_ERROR;
418:               	}
419:               	else
420:               	{
421:               		return BSD_SUCCESS;
422:               	}
423:               }
