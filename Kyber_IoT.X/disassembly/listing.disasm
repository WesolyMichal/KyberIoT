359:                   }
360:               
361:                   // Calculate MAC
362:                   atcac_sw_sha2_256_init(&ctx);
363:                   atcac_sw_sha2_256_update(&ctx, param->hashed_key, ATCA_KEY_SIZE);
364:                   atcac_sw_sha2_256_update(&ctx, param->digest, SECUREBOOT_DIGEST_SIZE);
