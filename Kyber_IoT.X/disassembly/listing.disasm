179:               /** \brief Decrypt data that's been encrypted by the IO protection key.
180:                *          The ECDH and KDF commands on the ATECC608A are the only ones that
181:                *          support this operation.
182:                *
183:                *    \param[inout] param  Parameters required to perform the operation.
184:                *
185:                *   \return ATCA_SUCCESS on success, otherwise an error code.
186:                */
187:               ATCA_STATUS atcah_io_decrypt(struct atca_io_decrypt_in_out *param)
188:               {
189:                   atcac_sha2_256_ctx ctx;
190:                   uint8_t key[ATCA_KEY_SIZE];
191:                   size_t block = 0;
192:                   int i;
193:               
194:                   if (param == NULL || param->io_key == NULL || param->out_nonce == NULL || param->data == NULL)
195:                   {
196:                       return ATCA_BAD_PARAM;
197:                   }
198:                   if (param->data_size % ATCA_BLOCK_SIZE != 0)
199:                   {
200:                       return ATCA_BAD_PARAM;
201:                   }
202:               
203:                   for (block = 0; block < param->data_size / ATCA_BLOCK_SIZE; block++)
204:                   {
205:                       // Calculate key for block
206:                       atcac_sw_sha2_256_init(&ctx);
207:                       atcac_sw_sha2_256_update(&ctx, param->io_key, 32);
208:                       atcac_sw_sha2_256_update(&ctx, &param->out_nonce[block * 16], 16);
209:                       atcac_sw_sha2_256_finish(&ctx, key);
210:               
211:                       // Decrypt block
212:                       for (i = 0; i < ATCA_BLOCK_SIZE; i++)
213:                       {
214:                           param->data[block * ATCA_BLOCK_SIZE + i] ^= key[i];
215:                       }
216:                   }
217:               
218:                   return ATCA_SUCCESS;
219:               }
