215:               static const uint8_t* atcacert_is_device_loc_match(const atcacert_device_loc_t* device_loc_dest,
216:                                                                  const atcacert_device_loc_t* device_loc_src,
217:                                                                  const uint8_t*               src_data)
218:               {
219:                   size_t dest_end = device_loc_dest->offset + device_loc_dest->count;
220:                   size_t src_end = device_loc_src->offset + device_loc_src->count;
221:               
222:                   if (device_loc_dest->zone == DEVZONE_NONE || device_loc_dest->count <= 0)
223:                   {
224:                       return NULL;    // device_loc_dest is a null location
225:                   }
226:                   if (device_loc_src->zone == DEVZONE_NONE || device_loc_src->count <= 0)
227:                   {
228:                       return NULL;    // device_loc_src is a null location
229:                   }
230:                   if (device_loc_dest->zone != device_loc_src->zone)
231:                   {
232:                       return NULL;
233:                   }
234:                   if (device_loc_dest->zone == DEVZONE_DATA && device_loc_dest->slot != device_loc_src->slot)
235:                   {
236:                       return NULL;
237:                   }
238:                   if (device_loc_dest->zone == DEVZONE_DATA && device_loc_dest->is_genkey != device_loc_src->is_genkey)
239:                   {
240:                       return NULL;
241:                   }
242:               
243:                   if (device_loc_dest->offset < device_loc_src->offset || dest_end > src_end)
244:                   {
245:                       return NULL;
246:                   }
247:               
248:                   // device_loc_dest is encompassed by device_loc_src, return a pointer to the data for device_loc_dest
249:                   return src_data + (device_loc_dest->offset - device_loc_src->offset);
250:               }
