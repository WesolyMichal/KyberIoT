380:               	memcpy((void*)winc_sockaddr.sa_data, (const void *)addr->sa_data, sizeof(winc_sockaddr.sa_data));
381:               
382:               	switch(winc_sockaddr.sa_family)
383:               	{
384:               		case PF_INET:
385:               			winc_sockaddr.sa_family = AF_INET;
386:               			wincBindReturn = bind((int8_t)socket, (struct sockaddr*)&winc_sockaddr, (uint8_t)addrlen);
387:               		break;
388:               		default:		//Address family not supported by WINC
389:               			bsd_setErrNo(EAFNOSUPPORT);
390:               			return BSD_ERROR;		
