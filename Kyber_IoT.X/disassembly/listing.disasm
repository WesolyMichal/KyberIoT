51:                // I2C Event Callback List
52:                typedef enum
53:                {
54:                    i2c_dataComplete = 0,
55:                    i2c_writeCollision,
56:                    i2c_addressNACK,
57:                    i2c_dataNACK,
58:                    i2c_timeOut,
59:                    i2c_NULL
