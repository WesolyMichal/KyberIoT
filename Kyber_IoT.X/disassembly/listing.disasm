656:               static int is_leap_year(int year)
657:               {
658:                   return (year % 400 == 0) || ((year % 4 == 0) && (year % 100 != 0));
659:               }
660:               
661:               static uint32_t get_year_secs(int year)
662:               {
663:                   if (is_leap_year(year))
664:                   {
665:                       return (31 + 29 + 31 + 30 + 31 + 30 + 31 + 31 + 30 + 31 + 30 + 31) * 86400;
666:                   }
667:                   else
668:                   {
669:                       return (31 + 28 + 31 + 30 + 31 + 30 + 31 + 31 + 30 + 31 + 30 + 31) * 86400;
670:                   }
671:               }
672:               
673:               static uint32_t get_month_secs(int year, int mon)
674:               {
675:                   static const uint32_t month_secs[] = { 2678400, 2419200, 2678400, 2592000, 2678400, 2592000, 2678400, 2678400, 2592000, 2678400, 2592000, 2678400 };
676:               
677:                   if (mon == 1 && is_leap_year(year))
678:                   {
679:                       return 2505600;
680:                   }
681:                   else if (mon < 12)
682:                   {
683:                       return month_secs[mon];
684:                   }
685:                   else
686:                   {
687:                       return 0;
688:                   }
689:               }
