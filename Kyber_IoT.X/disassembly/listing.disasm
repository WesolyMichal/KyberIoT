41:                 */
42:                ATCADevice newATCADevice(ATCAIfaceCfg *cfg)
43:                {
44:                    ATCADevice ca_dev = NULL;
45:                    ATCA_STATUS status;
46:                
47:                    if (cfg == NULL)
48:                    {
49:                        return NULL;
