574:               /*********************************************************************
575:               Function
576:               		bind
577:               
578:               Description
579:               		Request to bind a socket on a local address.
580:               
581:               Return
582:               
583:               
584:               Author
585:               		Ahmed Ezzat
586:               
587:               Version
588:               		1.0
589:               
590:               Date
591:               		5 June 2012
592:               *********************************************************************/
593:               sint8 bind(SOCKET sock, struct sockaddr *pstrAddr, uint8 u8AddrLen)
594:               {
595:               	sint8	s8Ret = SOCK_ERR_INVALID_ARG;
596:               	if((pstrAddr != NULL) && (sock >= 0) && (gastrSockets[sock].bIsUsed == 1) && (u8AddrLen != 0))
597:               	{
598:               		tstrBindCmd			strBind;
599:               		uint8				u8CMD = SOCKET_CMD_BIND;
600:               		if(gastrSockets[sock].u8SSLFlags & SSL_FLAGS_ACTIVE)
601:               		{
602:               			u8CMD = SOCKET_CMD_SSL_BIND;
603:               		}
604:               
605:               		/* Build the bind request. */
606:               		strBind.sock = sock;
000054  000534     NOP
607:               		m2m_memcpy((uint8 *)&strBind.strAddr, (uint8 *)pstrAddr, sizeof(tstrSockAddr));
608:               		strBind.u16SessionID		= gastrSockets[sock].u16SessionID;
609:               		
610:               		/* Send the request. */
611:               		s8Ret = SOCKET_REQUEST(u8CMD, (uint8*)&strBind,sizeof(tstrBindCmd) , NULL , 0, 0);
000074  000534     NOP
612:               		if(s8Ret != SOCK_ERR_NO_ERROR)
613:               		{
614:               			s8Ret = SOCK_ERR_INVALID;
615:               		}
616:               	}
617:               	return s8Ret;
618:               }
000094  000534     NOP
