695:                   {
696:                       return atcacert_set_cert_element(cert_def, &cert_def->std_cert_elements[STDCERT_SIGNATURE], cert, *cert_size, signature, 64);
697:                   }
698:               
699:                   if (sig_offset >= *cert_size)
700:                   {
701:                       return ATCACERT_E_ELEM_OUT_OF_BOUNDS;  // Signature element is shown as past the end of the certificate
702:               
703:                   }
704:                   // Current size of the signature is from its offset to the end of the cert
705:                   cur_der_sig_size = *cert_size - sig_offset;
706:               
707:                   // Find the size of buffer available for the new DER signature
708:                   new_der_sig_size = max_cert_size - sig_offset;
709:               
710:                   // Set the new signature
711:                   ret = atcacert_der_enc_ecdsa_sig_value(signature, &cert[sig_offset], &new_der_sig_size);
712:                   if (ret != ATCACERT_E_SUCCESS)
713:                   {
714:                       if (ret == ATCACERT_E_BUFFER_TOO_SMALL)
0000AA  000534     NOP
715:                       {
716:                           *cert_size += (int)new_der_sig_size - (int)cur_der_sig_size;  // Report the size needed
717:                       }
718:                       return ret;
0000C2  000534     NOP
719:                   }
720:               
721:                   *cert_size += (int)new_der_sig_size - (int)cur_der_sig_size;
0000C6  000534     NOP
722:               
723:                   old_cert_der_length_size = *cert_size - 1;
0000D8  000534     NOP
724:                   ret = atcacert_der_adjust_length(
0000E6  000534     NOP
725:                       &cert[1],
726:                       &old_cert_der_length_size,
727:                       (int)new_der_sig_size - (int)cur_der_sig_size,
728:                       &new_cert_length);
729:                   if (ret != ATCACERT_E_SUCCESS)
0000F4  000534     NOP
0000F6  000534     NOP
730:                   {
731:                       return ret;
0000FA  000534     NOP
732:                   }
733:               
734:                   // Tag, length, value
735:                   if (1 + old_cert_der_length_size + new_cert_length != *cert_size)
736:                   {
737:                       return ATCACERT_E_BAD_CERT;
738:                   }
739:               
740:                   return ATCACERT_E_SUCCESS;
741:               }
