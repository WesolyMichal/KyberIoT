284:               /**
285:                * \brief Verifies the signature of a jwt using the provided public key
286:                */
287:               ATCA_STATUS atca_jwt_verify(
288:                   const char*    buf,      /**< [in] Buffer holding an encoded jwt */
289:                   uint16_t       buflen,   /**< [in] Length of the buffer/jwt */
290:                   const uint8_t* pubkey    /**< [in] Public key (raw byte format) */
291:                   )
292:               {
000000  040100     GOTO __resetPRI, __reset
293:                   ATCA_STATUS status = ATCA_GEN_FAIL;
000008  000416     NOP
294:                   uint8_t digest[ATCA_KEY_SIZE];
295:                   uint8_t signature[ATCA_SIG_SIZE];
296:                   size_t sig_len = sizeof(signature);
00000C  0003F6     NOP
297:                   const char* pStr = buf;
000010  000534     NOP
298:               
299:                   bool verified = false;
000014  000534     NOP
300:               
301:                   if (!buf || !buflen || !pubkey)
000018  000534     NOP
302:                   {
303:                       return ATCA_BAD_PARAM;
00002A  000500     NOP
304:                   }
305:               
306:                   do
307:                   {
308:                       /* Payload */
309:                       pStr = strchr(pStr, '.') + 1;
00002E  000534     NOP
310:                       if (!pStr)
000038  000534     NOP
311:                       {
312:                           break;
0000AC  000534     NOP
313:                       }
314:               
315:                       /* Signature */
316:                       pStr = strchr(pStr, '.') + 1;
00003E  000534     NOP
317:                       if (!pStr)
000048  000534     NOP
318:                       {
319:                           break;
0000B0  000534     NOP
320:                       }
321:               
322:                       /* Extract the signature */
323:                       if (ATCA_SUCCESS != (status = atcab_base64decode_(pStr, strlen(pStr),
00004E  000534     NOP
324:                                                                         signature, &sig_len, atcab_b64rules_urlsafe)))
325:                       {
326:                           break;
0000B4  000534     NOP
327:                       }
328:               
329:                       /* Digest the token */
330:                       if (ATCA_SUCCESS != (status = atcac_sw_sha2_256((const uint8_t*)buf, pStr - buf - 1, digest)))
00006E  000534     NOP
331:                       {
332:                           break;
0000B8  000534     NOP
333:                       }
334:               
335:                       /* Do a signature verification using the device */
336:                       if (ATCA_SUCCESS != (status = atcab_verify_extern(digest, signature,
000086  000534     NOP
337:                                                                         pubkey, &verified)))
338:                       {
339:                           break;
0000BC  000534     NOP
340:                       }
341:               
342:                       if (!verified)
00009E  000534     NOP
343:                       {
344:                           status = ATCA_CHECKMAC_VERIFY_FAILED;
0000A6  000534     NOP
345:                       }
346:                   }
347:                   while (0);
348:               
349:                   return status;
0000BE  000534     NOP
350:               }
