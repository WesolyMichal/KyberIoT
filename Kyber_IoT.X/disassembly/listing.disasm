009250  060000     RETURN
381:               #ifndef USE_OLD_SPI_SW
382:               static int spi_cmd_complete(uint8_t cmd, uint32_t adr, uint8_t *b, uint32_t sz, uint8_t clockless)
383:               {
384:               	uint8_t wb[32], rb[32];
385:               	uint8_t wix, rix;
386:               	uint32_t len2;
387:               	uint8_t rsp;
388:               	int len = 0;
389:               	int result = N_OK;
390:               
391:               	wb[0] = cmd;
392:               	switch (cmd) {
393:               	case CMD_SINGLE_READ:				/* single word (4 bytes) read */
394:               		wb[1] = (uint8_t)(adr >> 16);
395:               		wb[2] = (uint8_t)(adr >> 8);
396:               		wb[3] = (uint8_t)adr;
397:               		len = 5;
398:               		break; 
399:               	case CMD_INTERNAL_READ:			/* internal register read */ 
400:               		wb[1] = (uint8_t)(adr >> 8);
401:               		if(clockless == 1)  wb[1] |= (1 << 7);
402:               		wb[2] = (uint8_t)adr;
403:               		wb[3] = 0x00;
404:               		len = 5;
405:               		break;
406:               	case CMD_TERMINATE:					/* termination */
407:               		wb[1] = 0x00;
408:               		wb[2] = 0x00;
409:               		wb[3] = 0x00;
410:               		len = 5;
411:               		break;
412:               	case CMD_REPEAT:						/* repeat */
413:               		wb[1] = 0x00;
414:               		wb[2] = 0x00;
415:               		wb[3] = 0x00;
416:               		len = 5;
417:               		break;
418:               	case CMD_RESET:							/* reset */
419:               		wb[1] = 0xff;
420:               		wb[2] = 0xff;
421:               		wb[3] = 0xff;
422:               		len = 5;
423:               		break;
424:               	case CMD_DMA_WRITE:					/* dma write */
425:               	case CMD_DMA_READ:					/* dma read */
426:               		wb[1] = (uint8_t)(adr >> 16);
427:               		wb[2] = (uint8_t)(adr >> 8);
428:               		wb[3] = (uint8_t)adr;
429:               		wb[4] = (uint8_t)(sz >> 8);
430:               		wb[5] = (uint8_t)(sz);
431:               		len = 7;
432:               		break;
433:               	case CMD_DMA_EXT_WRITE:		/* dma extended write */
434:               	case CMD_DMA_EXT_READ:			/* dma extended read */
435:               		wb[1] = (uint8_t)(adr >> 16);
436:               		wb[2] = (uint8_t)(adr >> 8);
437:               		wb[3] = (uint8_t)adr;
438:               		wb[4] = (uint8_t)(sz >> 16);
439:               		wb[5] = (uint8_t)(sz >> 8);
440:               		wb[6] = (uint8_t)(sz);
441:               		len = 8;
442:               		break;
443:               	case CMD_INTERNAL_WRITE:		/* internal register write */
444:               		wb[1] = (uint8_t)(adr >> 8);
445:               		if(clockless == 1)  wb[1] |= (1 << 7);
446:               		wb[2] = (uint8_t)(adr);
447:               		wb[3] = b[3];
448:               		wb[4] = b[2];
449:               		wb[5] = b[1];
450:               		wb[6] = b[0];
451:               		len = 8;
452:               		break;
453:               	case CMD_SINGLE_WRITE:			/* single word write */
454:               		wb[1] = (uint8_t)(adr >> 16);
455:               		wb[2] = (uint8_t)(adr >> 8);
456:               		wb[3] = (uint8_t)(adr);
457:               		wb[4] = b[3];
458:               		wb[5] = b[2];
459:               		wb[6] = b[1];
460:               		wb[7] = b[0];
461:               		len = 9;
462:               		break;
463:               	default:
464:               		result = N_FAIL;
465:               		break;
466:               	}
467:               
468:               	if (result != N_OK) {
469:               		return result;
470:               	}
471:               
472:               	if (!gu8Crc_off) {
473:               		wb[len-1] = (crc7(0x7f, (const uint8_t *)&wb[0], len-1)) << 1;
474:               	} else {
475:               		len -=1;
476:               	}
477:               
478:               #define NUM_SKIP_BYTES (1)
479:               #define NUM_RSP_BYTES (2)
480:               #define NUM_DATA_HDR_BYTES (1)
481:               #define NUM_DATA_BYTES (4)
482:               #define NUM_CRC_BYTES (2)
483:               #define NUM_DUMMY_BYTES (3)
484:               
485:               	if ((cmd == CMD_RESET) ||
486:               		(cmd == CMD_TERMINATE) ||
487:               		(cmd == CMD_REPEAT)) {
488:               			len2 = len + (NUM_SKIP_BYTES + NUM_RSP_BYTES + NUM_DUMMY_BYTES);
489:               	} else if ((cmd == CMD_INTERNAL_READ) || (cmd == CMD_SINGLE_READ)) {
490:               		if (!gu8Crc_off) {
491:               			len2 = len + (NUM_RSP_BYTES + NUM_DATA_HDR_BYTES + NUM_DATA_BYTES 
492:               			+ NUM_CRC_BYTES + NUM_DUMMY_BYTES);	
493:               		} else {
494:               			len2 = len + (NUM_RSP_BYTES + NUM_DATA_HDR_BYTES + NUM_DATA_BYTES 
495:               			+ NUM_DUMMY_BYTES);
496:               		}
497:               	} else {
498:               		len2 = len + (NUM_RSP_BYTES + NUM_DUMMY_BYTES);
499:               	}
500:               #undef NUM_DUMMY_BYTES
501:               
502:               	if(len2 > (sizeof(wb)/sizeof(wb[0]))) {
503:               		M2M_ERR("[nmi spi]: spi buffer size too small (%d) (%d)\n",
504:               			len2, (sizeof(wb)/sizeof(wb[0])));
505:               		result = N_FAIL;
506:               		return result;
507:               	}
508:               	/* zero spi write buffers. */
509:               	for(wix = len; wix< len2; wix++) {
510:               		wb[wix] = 0;
511:               	}
512:               	rix = len;
513:               
514:               	if (nmi_spi_rw(wb, rb, len2) != M2M_SUCCESS) {
515:               		M2M_ERR("[nmi spi]: Failed cmd write, bus error...\n");
516:               		result = N_FAIL;
517:               		return result;
518:               	}
519:               
520:               #if 0
521:               	{
522:               		int jj;
523:               		printk("--- cnd = %x, len=%d, len2=%d\n", cmd, len, len2);
524:               		for(jj=0; jj<sizeof(wb)/sizeof(wb[0]); jj++) {
525:               
526:               			if(jj >= len2) break;
527:               			if(((jj+1)%16) != 0) {
528:               				if((jj%16) == 0) {
529:               					printk("wb[%02x]: %02x ", jj, wb[jj]);
530:               				} else {
531:               					printk("%02x ", wb[jj]);
532:               				}
533:               			} else {
534:               				printk("%02x\n", wb[jj]);
535:               			}
536:               		}
537:               		printk("\n");
538:               
539:               		for(jj=0; jj<sizeof(rb)/sizeof(rb[0]); jj++) {
540:               
541:               				if(jj >= len2) break;
542:               				if(((jj+1)%16) != 0) {
543:               					if((jj%16) == 0) {
544:               						printk("rb[%02x]: %02x ", jj, rb[jj]);
545:               					} else {
546:               						printk("%02x ", rb[jj]);
547:               					}
548:               				} else {
549:               					printk("%02x\n", rb[jj]);
550:               				}
551:               			}
552:               		printk("\n");
553:               	}
554:               #endif
555:               
556:               	/**
557:               	Command/Control response
558:               	**/
559:               	if ((cmd == CMD_RESET) ||
560:               		(cmd == CMD_TERMINATE) ||
561:               		(cmd == CMD_REPEAT)) {
562:               			rix++; /* skip 1 byte */
563:               	}
564:               
565:               	rsp = rb[rix++];
566:               
567:               
568:               	if (rsp != cmd) {
569:               		M2M_ERR("[nmi spi]: Failed cmd response, cmd (%02x), resp (%02x)\n", cmd, rsp);
570:               		result = N_FAIL;
571:               		return result;
572:               	}
573:               
574:               	/**
575:               	State response
576:               	**/
577:               	rsp = rb[rix++];
578:               	if (rsp != 0x00) {
579:               		M2M_ERR("[nmi spi]: Failed cmd state response state (%02x)\n", rsp);
580:               		result = N_FAIL;
581:               		return result;
582:               	}
583:               
584:               	if ((cmd == CMD_INTERNAL_READ) || (cmd == CMD_SINGLE_READ)
585:               		|| (cmd == CMD_DMA_READ) || (cmd == CMD_DMA_EXT_READ)) {
586:               			int retry;
587:               			//uint16_t crc1, crc2;
588:               			uint8_t crc[2];
589:               			/**
590:               			Data Respnose header
591:               			**/
592:               			retry = SPI_RESP_RETRY_COUNT;
593:               			do {
594:               				/* ensure there is room in buffer later to read data and crc */
595:               				if(rix < len2) { 
596:               					rsp = rb[rix++];
597:               				} else {
598:               					retry = 0;
599:               					break;
600:               				}
601:               				if (((rsp >> 4) & 0xf) == 0xf)
602:               					break;
603:               			} while (retry--);
604:               
605:               			if (retry <= 0) {
606:               				M2M_ERR("[nmi spi]: Error, data read response (%02x)\n", rsp);
607:               				result = N_RESET;
608:               				return result;
609:               			}
610:               
611:               			if ((cmd == CMD_INTERNAL_READ) || (cmd == CMD_SINGLE_READ)) {
612:               				/**
613:               				Read bytes
614:               				**/
615:               				if((rix+3) < len2) { 
616:               					b[0] = rb[rix++];
617:               					b[1] = rb[rix++];
618:               					b[2] = rb[rix++];
619:               					b[3] = rb[rix++];
620:               				} else {
621:               					M2M_ERR("[nmi spi]: buffer overrun when reading data.\n");
622:               					result = N_FAIL;
623:               					return result;
624:               				}
625:               
626:               				if (!gu8Crc_off) {						
627:               					/**
628:               					Read Crc
629:               					**/
630:               					if((rix+1) < len2) { 
631:               						crc[0] = rb[rix++];
632:               						crc[1] = rb[rix++];
633:               					} else {
634:               						M2M_ERR("[nmi spi]: buffer overrun when reading crc.\n");
635:               						result = N_FAIL;
636:               						return result;
637:               					}
638:               				}
639:               			} else if((cmd == CMD_DMA_READ) || (cmd == CMD_DMA_EXT_READ)) {
640:               				int ix;
641:               
642:               				/* some data may be read in response to dummy bytes. */
643:               				for(ix=0; (rix < len2) && (ix < sz);) {
644:               					b[ix++] = rb[rix++];				
645:               				}
646:               #if 0
647:               				if(ix) M2M_INFO("ttt %d %d\n", sz, ix);
648:               #endif
649:               				sz -= ix;
650:               
651:               				if(sz > 0) {
652:               					int nbytes;
653:               					
654:               					if (sz <= (DATA_PKT_SZ-ix)) {
655:               						nbytes = sz;
656:               					} else {
657:               						nbytes = DATA_PKT_SZ-ix;
658:               					}
659:               
660:               					/**
661:               					Read bytes
662:               					**/
663:               					if (nmi_spi_read(&b[ix], nbytes) != M2M_SUCCESS) {
664:               						M2M_ERR("[nmi spi]: Failed data block read, bus error...\n");
665:               						result = N_FAIL;
666:               						goto _error_;
667:               					}
668:               
669:               					/**
670:               					Read Crc
671:               					**/
672:               					if (!gu8Crc_off) {
673:               						if (nmi_spi_read(crc, 2) != M2M_SUCCESS) {
674:               							M2M_ERR("[nmi spi]: Failed data block crc read, bus error...\n");
675:               							result = N_FAIL;
676:               							goto _error_;
677:               						}
678:               					}
679:               
680:               					
681:               					ix += nbytes;
682:               					sz -= nbytes;
683:               				}
684:               
685:               				/*  if any data in left unread, then read the rest using normal DMA code.*/	
686:               				while(sz > 0) {
687:               					int nbytes;
688:               			
689:               					if (sz <= DATA_PKT_SZ) {
690:               						nbytes = sz;
691:               					} else {
692:               						nbytes = DATA_PKT_SZ;
693:               					}
694:               
695:               					/** 
696:               					read data response only on the next DMA cycles not 
697:               					the first DMA since data response header is already 
698:               					handled above for the first DMA.
699:               					**/
700:               					/**
701:               					Data Respnose header
702:               					**/
703:               					retry = SPI_RESP_RETRY_COUNT;
704:               					do {
705:               						if (nmi_spi_read(&rsp, 1) != M2M_SUCCESS) {
706:               							M2M_ERR("[nmi spi]: Failed data response read, bus error...\n");
707:               							result = N_FAIL;
708:               							break;
709:               						}
710:               						if (((rsp >> 4) & 0xf) == 0xf)
711:               							break;
712:               					} while (retry--);
713:               
714:               					if (result == N_FAIL)
715:               						break;
716:               
717:               
718:               					/**
719:               					Read bytes
720:               					**/
721:               					if (nmi_spi_read(&b[ix], nbytes) != M2M_SUCCESS) {
722:               						M2M_ERR("[nmi spi]: Failed data block read, bus error...\n");
723:               						result = N_FAIL;
724:               						break;
725:               					}
726:               
727:               					/**
728:               					Read Crc
729:               					**/
730:               					if (!gu8Crc_off) {
731:               						if (nmi_spi_read(crc, 2) != M2M_SUCCESS) {
732:               							M2M_ERR("[nmi spi]: Failed data block crc read, bus error...\n");
733:               							result = N_FAIL;
734:               							break;
735:               						}
736:               					}
737:               
738:               					ix += nbytes;
739:               					sz -= nbytes;
740:               				}
741:               			}
742:               	}
743:               _error_:
744:               	return result;
745:               }
746:               #endif
